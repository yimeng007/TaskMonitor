<!-- TextOptions.TextFormattingMode="Display"：设置页是长列表（外观页 77 个卡片、约 3000px 高），
     滚动时 Ideal 模式每帧都要重新做字形 shaping，是滚轮大幅滚动掉帧的主要来源之一。
     Display 用 GDI 兼容度量，滚动明显更顺，小字号也更清晰；代价是字宽略有差异，
     对本页（12–14px 正文）无可见影响。 -->
<Window x:Class="task_monitor.SettingsWindow"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:local="clr-namespace:task_monitor"
        mc:Ignorable="d"
        Title="设置"
        Width="1040" Height="720"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:WindowHelper.SystemBackdropType="Mica"
        ui:TitleBar.ExtendViewIntoTitleBar="True"
        ui:TitleBar.Height="32">

    <Window.Resources>
        <!-- Push the content CARD below the caption strip. Theme default is 0 — the card
             then starts flush at the window top (its white surface runs right up behind
             the caption buttons, reading as "content level with the title bar"). The
             Gallery look — a Mica strip first, then the floating card — is exactly this
             resource overridden (the Gallery uses 0,48 to match its TitleBar.Height=48;
             ours is 32). IsTitleBarAutoPaddingEnabled is OFF (below), so nothing adds a
             second in-card band — page content starts right at the card's top edge. -->
        <Thickness x:Key="NavigationViewContentMargin">0,32,0,0</Thickness>

        <!-- Page title at the top of each nav category page (Win11 Settings' big
             header, scrolling away WITH the page — no fixed NavigationView.Header). -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="1,16,0,12" />
        </Style>

        <!-- 曲线颜色的色块 = a Button, NOT a Border. The 外观 page lives inside a
             TouchDragScrollViewer, which captures the mouse on press to drag-scroll; a Border
             does no capture of its own, so its MouseLeftButtonUp never came back and every
             swatch was dead to clicks (2026-11-09「反复点不到生效」). ButtonBase captures the
             mouse itself and raises Click either way. The template is stripped to a selection
             ring + the content ellipse, so iNKORE's chrome (grey box, hover fill) never shows. -->
        <Style x:Key="GraphSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,2,4,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Window.Foreground (set above): unset TextBlocks/FontIcons inherit the theme color
         (WPF's built-in default is hard Black); explicit local values still win. -->
    <Grid>
        <!-- The 类别 shell: an iNKORE NavigationView, Win11-Settings style. The pane
             is transparent over the Mica, the content area is the library's layer
             card (pushed below the caption strip by the NavigationViewContentMargin
             override in Window.Resources). IsTitleBarAutoPaddingEnabled is OFF: its
             single TemplateSettings.TopPadding feeds THREE spots (the pane toggle
             row, the pane content AND an in-card band above the page) — off removes
             the dead white band at the card's top so every page starts at the card's
             edge; the hamburger then lives in the caption strip (the usual Fluent
             pattern), which the caption band's left margin below makes room for.
             The back button is collapsed (no stack to go back on) or Auto would show
             a dead arrow. PaneDisplayMode stays Auto: ≥1008 DIP (the default window
             size) the pane is open with labels, 641–1007 icon-compact, <641 minimal
             hamburger.

             OpenPaneLength 显式定死 240：库默认是 320，而这栏里只有「通用/外观/采样项目」
             这种两三个字的短词，320 会留下近 100 px 的空档，内容卡片被推得老远
             （2026-11-11 用户反馈「往左移、调合理大小」）。240 刚好容纳图标 + 4 个字 + 边距。 -->
        <ui:NavigationView x:Name="NavView"
                           IsBackButtonVisible="Collapsed"
                           IsTitleBarAutoPaddingEnabled="False"
                           OpenPaneLength="240"
                           SelectionChanged="NavView_SelectionChanged">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavGeneral" Content="通用" IsSelected="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Options_20_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavAppearance" Content="外观">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.PaintBrush_20_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem x:Name="NavSampling" Content="采样项目">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Gauge_20_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <!-- 关于 sits at the pane's bottom-left (Win11-Settings style), out of the
                 scrollable category list; selection flows through the same
                 NavView_SelectionChanged as the categories above. -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="NavAbout" Content="关于">
                    <ui:NavigationViewItem.Icon>
                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Info_20_Regular}" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>

            <!-- ONE page per 类别, switched by VISIBILITY (NavView_SelectionChanged),
                 not Frame navigation: the whole window keeps a single namescope, so
                 every control/handler pair — and the ctor's initial-state push into
                 all of them — works exactly as the old single scroll page did, and
                 each page keeps its own scroll position across switches. Cards are
                 iNKORE SettingsCard; groups with sub-items are SettingsExpander (a
                 toggle in its content area does not toggle the expansion). 4px between
                 cards.
                 TouchDragScrollViewer (SmoothScrollViewer 子类): 滚轮/触控板走
                 RenderTransform 平滑物理 (v3, blog.twlmgatito.com/posts/wpf-fluent-scrollviewer-v3);
                 触屏拖拽走自实现的延迟捕获 (TouchDragScrollViewer.cs 头注有完整设计) ——
                 不用库的 manipulation (TouchDown 即捕获触摸点, tap 不再晋升点击, 开关全失灵)
                 也不用原生 PanningMode (布局驱动, 每个触摸 move 都整页布局, 弱 GPU 掉帧)。
                 Style 必须显式指回 iNKORE 的 ScrollViewer 隐式样式: WPF 无 key 样式只精确
                 匹配 TargetType, 派生控件吃不到它 → 回退成 Aero 经典条
                 (滚动条不自动隐藏的根源, dump 实测 Style==null); DynamicResource 跟随深浅色切换。 -->
            <Grid>
                <local:TouchDragScrollViewer x:Name="GeneralPage"
                                             VerticalScrollBarVisibility="Auto"
                                             Style="{DynamicResource {x:Type ScrollViewer}}"
                                             IsEnableSmoothManipulating="False" PanningMode="None"
                                             local:ScrollCacheDuringTouch.Enabled="False">
                    <local:TouchDragScrollViewer.Physics>
                        <local:SnappyScrollPhysics />
                    </local:TouchDragScrollViewer.Physics>
                    <StackPanel Margin="44,0,44,32">

                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="通用" />

                        <ui:SettingsCard Header="开机自启"
                                         Margin="0,0,0,4">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Rocket_20_Regular}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="AutoStartSwitch" Toggled="AutoStartSwitch_Toggled" />
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="采样间隔"
                                         Margin="0,0,0,4">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Timer_20_Regular}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="IntervalCombo" MinWidth="140" SelectionChanged="IntervalCombo_SelectionChanged">
                                <ComboBoxItem Content="0.5 秒" />
                                <ComboBoxItem Content="1 秒（默认）" />
                                <ComboBoxItem Content="2 秒" />
                            </ComboBox>
                        </ui:SettingsCard>

                        <!-- 检查更新: takes effect on the NEXT startup (the check runs once per
                             launch); off also disables the 更新源 picker inside. -->
                        <ui:SettingsExpander Header="检查更新"
                                             IsExpanded="True"
                                             Description="启动时检测是否有新版本。"
                                             Margin="0,0,0,4">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ArrowSync_20_Regular}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:ToggleSwitch x:Name="UpdateCheckSwitch" Toggled="UpdateCheckSwitch_Toggled" />
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard Header="更新源">
                                    <ComboBox x:Name="UpdateSourceCombo" MinWidth="140" SelectionChanged="UpdateSourceCombo_SelectionChanged">
                                        <ComboBoxItem Content="CNB" />
                                        <ComboBoxItem Content="GitHub" />
                                    </ComboBox>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <!-- 版本水印：一行极淡的小字，填在「通用」页的空白处，不占任何功能位置。
                             文本由代码注入（VersionInfo.Current），改版本号不需要动 XAML。
                             作用：截图求助/对比时一眼知道是哪个修改版的哪一版。 -->
                        <TextBlock x:Name="VersionWatermark"
                                   FontSize="11"
                                   Margin="2,14,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                    </StackPanel>
                </local:TouchDragScrollViewer>

                <!-- 2026-11-14 实测定论：设置页**不要**挂 BitmapCache。
                     缓存的是整页 3000px 内容，起滚那一下要栅格化整页 = 明显一顿，
                     而滚动本身只是平移，视口重绘远比整页位图便宜。四页统一关闭。 -->
                <local:TouchDragScrollViewer x:Name="AppearancePage"
                                             Visibility="Collapsed"
                                             VerticalScrollBarVisibility="Auto"
                                             Style="{DynamicResource {x:Type ScrollViewer}}"
                                             IsEnableSmoothManipulating="False" PanningMode="None"
                                             local:ScrollCacheDuringTouch.Enabled="False">
                    <local:TouchDragScrollViewer.Physics>
                        <local:SnappyScrollPhysics />
                    </local:TouchDragScrollViewer.Physics>
                    <StackPanel Margin="44,0,44,32">

                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="外观" />

                        <ui:SettingsCard x:Name="ThemeCard" Header="主题"
                                         Margin="0,0,0,4">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Color_20_Regular}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="ThemeCombo" MinWidth="140" SelectionChanged="ThemeCombo_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" />
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                            </ComboBox>
                        </ui:SettingsCard>

                        <!-- 任务栏位置开关: the switch lives in the expander's content area; its only
                             sub-setting (任务栏位置) is an item inside, enabled only while on.
                             On the classical (Win10) taskbar 任务栏位置 does not exist, so the
                             expander would be a chevron opening onto nothing — the ctor hides it
                             and uses OnLeftCard below instead. -->
                        <ui:SettingsExpander x:Name="OnLeftExpander" Header="任务栏位置开关"
                                             IsExpanded="True"
                                             Description="系统任务栏在底部（默认）或顶部时生效：开启则按下面的「任务栏位置」摆放；关闭则固定在任务栏最左端。切到左侧或右侧时按下方「竖排任务栏」的规则。"
                                             Margin="0,0,0,4">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.PanelLeft_20_Regular}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:ToggleSwitch x:Name="OnLeftSwitch" Toggled="OnLeftSwitch_Toggled" />
                            <ui:SettingsExpander.Items>
                                <ui:SettingsCard x:Name="AnchorCard" Header="任务栏位置"
                                                 Description="仅在上面的开关开启时生效。">
                                    <ComboBox x:Name="AnchorCombo" MinWidth="140" SelectionChanged="AnchorCombo_SelectionChanged">
                                        <ComboBoxItem Content="任务栏最左端" />
                                        <ComboBoxItem Content="贴近开始按钮" />
                                        <ComboBoxItem Content="贴近系统托盘" />
                                    </ComboBox>
                                </ui:SettingsCard>

                                <ui:SettingsCard Header="竖排任务栏"
                                                 Description="系统任务栏切到屏幕左侧或右侧（竖排）时，本工具自动避开开始按钮：开始按钮在中段就贴顶部，开始按钮在顶端就贴托盘上方；改「任务栏对齐方式」后会自动换到另一端，不需重启。">
                                    <ui:SettingsCard.HeaderIcon>
                                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.PanelLeft_20_Regular}" />
                                    </ui:SettingsCard.HeaderIcon>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <!-- 任务栏位置开关 on the classical (Win10) taskbar: the same setting as a plain
                             card — 任务栏位置 means nothing there (its single spot is the task-buttons
                             band's end next to Start), so the expander would be a chevron opening
                             onto nothing. The ctor moves the expander's icon and its ToggleSwitch
                             in here, so the switch exists exactly once and both forms share one
                             piece of state. -->
                        <ui:SettingsCard x:Name="OnLeftCard" Header="任务栏位置开关"
                                         Description="显示在任务栏靠开始按钮的一端（竖直任务栏为顶部）。"
                                         Visibility="Collapsed"
                                         Margin="0,0,0,4" />

                        <ui:SettingsExpander x:Name="DisplayExpander" Header="任务栏显示器"
                                             IsExpanded="True"
                                             Description="选择要同时显示任务栏窗口的显示器，至少保留一项。副屏需开启 Windows 的“在所有显示器上显示任务栏”。"
                                             Margin="0,0,0,4">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.WindowMultiple_20_Regular}" />
                            </ui:SettingsExpander.HeaderIcon>
                        </ui:SettingsExpander>

                        <!-- 紧凑模式: tightens the item pitch of the taskbar overlay AND the floating
                             widget — narrower cells (and a smaller row inset), a tighter vertical
                             grid row and two-line block. The switch is live: the overlay re-lays
                             out and resizes the moment it flips. Applies to both forms, so it is a
                             plain card, never gated on 悬浮模式. -->
                        <ui:SettingsCard x:Name="CompactCard" Header="紧凑模式"
                                         Description="收紧任务栏与悬浮窗中各项目之间的间距。"
                                         Margin="0,0,0,4">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.TextColumnOneNarrow_20_Regular}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="CompactSwitch" Toggled="CompactSwitch_Toggled" />
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="显示分割线"
                                         Description="在任务栏窗口与悬浮窗的各采样项目之间显示分割线。"
                                         Margin="0,0,0,4">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.DividerTall_20_Regular}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="ShowSeparatorsSwitch" Toggled="ShowSeparatorsSwitch_Toggled" />
                        </ui:SettingsCard>

                        <!-- 网络流量统计：两个常用开关放在表头（随时可见），三个「进阶」选项折进
                             Items 里、默认收起 —— 用户 2026-11-12 反馈：这几张卡一字排开太占纵向空间，
                             而且固定 GB / 历史保留 / 往月显示都不是天天调的东西，收起来更清爽。
                             FixedGbCard 仍会被 RefreshNetUsageUnitAvailability 置灰（本月+今日都关时）。 -->
                        <ui:SettingsExpander x:Name="NetUsageCard" Header="网络流量统计"
                                             IsExpanded="False"
                                             Description="详情弹窗里显示累计流量（只统计程序运行期间）。本月每月 1 号归零，今日每天 0 点归零。展开可调单位口径、历史保留月数与「往月」行的显示。"
                                             Margin="0,0,0,4">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Gauge_20_Regular}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                <TextBlock Text="本月" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:ToggleSwitch x:Name="ShowMonthUsageSwitch" Toggled="ShowMonthUsageSwitch_Toggled" />
                                <TextBlock Text="今日" FontSize="12" VerticalAlignment="Center" Margin="16,0,6,0" />
                                <ui:ToggleSwitch x:Name="ShowTodayUsageSwitch" Toggled="ShowTodayUsageSwitch_Toggled" />
                            </StackPanel>
                            <ui:SettingsExpander.Items>
                                <!-- 两个开关都关着时这张会被置灰（见 RefreshNetUsageUnitAvailability）：
                                     既然一行都不显示，单位怎么显示就没意义了。 -->
                                <ui:SettingsCard x:Name="FixedGbCard" Header="固定按 GB 显示"
                                                 Description="打开后超过 1024 GB 也不换算成 TB，继续用 GB 显示（1025 GB 就是 1025 GB）；不到 1 GB 时仍按 MB 显示。数值仅供参照，实际用量以运营商为准。关闭则自动升到 TB。">
                                    <ui:SettingsCard.HeaderIcon>
                                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Options_20_Regular}" />
                                    </ui:SettingsCard.HeaderIcon>
                                    <ui:ToggleSwitch x:Name="FixedGbSwitch" Toggled="FixedGbSwitch_Toggled" />
                                </ui:SettingsCard>

                                <!-- 多月历史保留月数（2026-11-12 加）。历史写在 exe 同目录的
                                     net_history.json，跨月时把上个月的最终数字存一条，超出保留数就裁掉最早的。
                                     用下拉而不是数字框：可选值就那几档，数字框还要处理非法输入与空值。
                                     默认 3 个月 —— 「保底」的语义：至少留住上个季度。 -->
                                <ui:SettingsCard x:Name="NetHistoryCard" Header="流量历史保留"
                                                 Description="跨月时把上个月的最终数字存进 net_history.json（与 exe 同目录），超出保留月数的自动裁掉最早的。默认 3 个月，最多 12 个月（再多详情弹窗那一行会拉得太长）；删掉这个文件只丢历史，不影响配置与本月累计。">
                                    <ui:SettingsCard.HeaderIcon>
                                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.History_20_Regular}" />
                                    </ui:SettingsCard.HeaderIcon>
                                    <ComboBox x:Name="NetHistoryKeepCombo" MinWidth="110"
                                              SelectionChanged="NetHistoryKeepCombo_SelectionChanged">
                                        <ComboBoxItem Content="保留 3 个月" Tag="3" />
                                        <ComboBoxItem Content="保留 6 个月" Tag="6" />
                                        <ComboBoxItem Content="保留 9 个月" Tag="9" />
                                        <ComboBoxItem Content="保留 12 个月" Tag="12" />
                                    </ComboBox>
                                </ui:SettingsCard>

                                <!-- 往月那一行的显示开关。默认关：关掉只影响显示，历史照样按月记录。 -->
                                <ui:SettingsCard Header="显示往月流量"
                                                 Description="在「网络」详情弹窗底部多显示一行「往月：…」，列出最近几个已过去月份的累计。默认关闭 —— 打开会让弹窗多一两行；关掉只影响显示，历史照样按月记录。">
                                    <ui:SettingsCard.HeaderIcon>
                                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.History_20_Regular}" />
                                    </ui:SettingsCard.HeaderIcon>
                                    <ui:ToggleSwitch x:Name="NetHistoryShowSwitch" Toggled="NetHistoryShowSwitch_Toggled" />
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <!-- 已用走势 + 曲线颜色：曲线颜色只有开了走势才有意义，索性折进同一个分组
                             （用户 2026-11-12 反馈「这个是否再折叠」）。默认收起，展开才看到色板。 -->
                        <ui:SettingsExpander Header="已用走势"
                                             IsExpanded="False"
                                             Description="在每个采样项目背后画出最近 20 个采样点的已用率曲线：最旧在左、最新在右，随采样自动向左滚动。时长＝20 × 采样间隔（1 秒间隔时为 20 秒）。展开可改曲线颜色。"
                                             Margin="0,0,0,4">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Gauge_20_Regular}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:ToggleSwitch x:Name="OverlayUsageGraphSwitch" Toggled="OverlayUsageGraphSwitch_Toggled" />
                            <ui:SettingsExpander.Items>
                            <ui:SettingsCard Header="曲线颜色"
                                             Description="已用走势开启后生效：曲线的颜色；选「跟随系统」会用 Windows 强调色，系统换色后约 5 秒跟上。"
                                             Margin="0,0,0,4">
                                <ui:SettingsCard.HeaderIcon>
                                    <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Color_20_Regular}" />
                                </ui:SettingsCard.HeaderIcon>
                                <WrapPanel MaxWidth="196" HorizontalAlignment="Right">
                                    <Button x:Name="GraphColorSwatchBlue" Style="{StaticResource GraphSwatchButtonStyle}"
                                            Tag="#0078D4" ToolTip="蓝" Click="GraphColorSwatch_Click">
                                        <Ellipse Width="14" Height="14" Fill="#0078D4" />
                                    </Button>
                                    <Button x:Name="GraphColorSwatchTeal" Style="{StaticResource GraphSwatchButtonStyle}"
                                            Tag="#00B7C3" ToolTip="青" Click="GraphColorSwatch_Click">
                                        <Ellipse Width="14" Height="14" Fill="#00B7C3" />
                                    </Button>
                                    <Button x:Name="GraphColorSwatchGreen" Style="{StaticResource GraphSwatchButtonStyle}"
                                            Tag="#107C10" ToolTip="绿" Click="GraphColorSwatch_Click">
                                        <Ellipse Width="14" Height="14" Fill="#107C10" />
                                    </Button>
                                    <Button x:Name="GraphColorSwatchOrange" Style="{StaticResource GraphSwatchButtonStyle}"
                                            Tag="#F7630C" ToolTip="橙" Click="GraphColorSwatch_Click">
                                        <Ellipse Width="14" Height="14" Fill="#F7630C" />
                                    </Button>
                                    <Button x:Name="GraphColorSwatchPurple" Style="{StaticResource GraphSwatchButtonStyle}"
                                            Tag="#8764B8" ToolTip="紫" Click="GraphColorSwatch_Click">
                                        <Ellipse Width="14" Height="14" Fill="#8764B8" />
                                    </Button>
                                    <Button x:Name="GraphColorSwatchRed" Style="{StaticResource GraphSwatchButtonStyle}"
                                            Tag="#E81123" ToolTip="红" Click="GraphColorSwatch_Click">
                                        <Ellipse Width="14" Height="14" Fill="#E81123" />
                                    </Button>
                                    <Button x:Name="GraphColorSwatchFollow" Style="{StaticResource GraphSwatchButtonStyle}"
                                            Tag="" ToolTip="跟随系统强调色" Click="GraphColorSwatch_Click">
                                        <Ellipse Width="14" Height="14">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#0078D4" Offset="0" />
                                                    <GradientStop Color="#107C10" Offset="0.5" />
                                                    <GradientStop Color="#F7630C" Offset="1" />
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Button>
                                </WrapPanel>
                            </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <ui:SettingsExpander x:Name="ItemOrderExpander" Header="项目顺序"
                                             IsExpanded="True"
                                             Description="拖动下方项目，调整任务栏窗口与悬浮窗的显示顺序；关闭采样的项目也会保留。"
                                             Margin="0,0,0,4">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.ReOrder_20_Regular}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <Button Content="恢复默认" Click="ResetItemOrder_Click" />
                        </ui:SettingsExpander>

                        <!-- 悬浮模式: the overlay leaves the taskbar entirely and lives on the
                             desktop as a draggable acrylic widget (the detail popup's material).
                             Its five sub-settings (置顶显示 / 允许越界 / 贴边隐藏 / 全屏时隐藏 / 透明度) are items
                             inside, enabled only while the mode is on — the same shape as
                             任务栏位置开关/任务栏位置 above. -->
                        <ui:SettingsExpander x:Name="FloatingExpander" Header="悬浮模式"
                                             IsExpanded="True"
                                             Description="从任务栏脱离开来，作为可拖动的悬浮窗显示（任务栏上不再显示）。"
                                             Margin="0,0,0,4">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.WindowMultiple_20_Regular}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:ToggleSwitch x:Name="FloatingSwitch" Toggled="FloatingSwitch_Toggled" />
                            <ui:SettingsExpander.Items>
                                <!-- 置顶显示: the widget sits in the topmost band, so it stays above
                                     everything — including the desktop that 「显示桌面」 brings to the
                                     front. Off = an ordinary window: the desktop covers it (the
                                     2026-11-11 report "一键回到桌面就看不见了" — see the Description). -->
                                <ui:SettingsCard x:Name="FloatingTopmostCard" Header="置顶显示"
                                                 Description="开启后悬浮窗始终在其他窗口（含「显示桌面」后的桌面）之上；关闭则和普通窗口一样会被桌面盖住。">
                                    <ui:ToggleSwitch x:Name="FloatingTopmostSwitch" Toggled="FloatingTopmostSwitch_Toggled" />
                                </ui:SettingsCard>
                                <ui:SettingsCard x:Name="FloatingOutOfBoundsCard" Header="允许超出屏幕边界"
                                                 Description="允许把悬浮窗拖到屏幕边缘之外；关闭时会立即拉回工作区。">
                                    <ui:ToggleSwitch x:Name="FloatingOutOfBoundsSwitch" Toggled="FloatingOutOfBoundsSwitch_Toggled" />
                                </ui:SettingsCard>
                                <!-- 贴边隐藏: drag the widget onto the 左/右/上 screen edge and it
                                     slides out of sight, leaving a narrow strip; hovering the strip
                                     pops it back out and the mouse leaving folds it away again. The
                                     dock is derived from the widget's saved home, so turning this on
                                     while the widget sits at an edge hides it immediately. -->
                                <ui:SettingsCard x:Name="FloatingEdgeHideCard" Header="贴边隐藏"
                                                 Description="拖到屏幕左、右或上边缘时自动收起，只留一条窄边；鼠标移到窄边上会自动弹出，移开后自动收起。">
                                    <ui:ToggleSwitch x:Name="FloatingEdgeHideSwitch" Toggled="FloatingEdgeHideSwitch_Toggled" />
                                </ui:SettingsCard>
                                <!-- 全屏时隐藏: the widget disappears while a FULLSCREEN app is in
                                     the foreground on its monitor (borderless game, F11 video,
                                     slideshow) and comes back when the foreground stops being
                                     fullscreen. Maximized windows don't count — only真 fullscreen
                                     covers the whole monitor; a hidden widget keeps sampling. -->
                                <ui:SettingsCard x:Name="FloatingFullscreenHideCard" Header="全屏时隐藏"
                                                 Description="有应用铺满整块屏幕时（如游戏、全屏视频）自动隐藏悬浮窗，退出全屏后自动恢复；最大化的窗口、「显示桌面」都不会触发。">
                                    <ui:ToggleSwitch x:Name="FloatingFullscreenHideSwitch" Toggled="FloatingFullscreenHideSwitch_Toggled" />
                                </ui:SettingsCard>
                                <!-- 透明度: BACKGROUND-only — the card's alpha IS this value (100% =
                                     a fully opaque card, the old tint look sits at 80%) and the card
                                     outline scales with it; text keeps full opacity (文字不要有
                                     透明度). Slider in whole percents, 20 floor. Live while dragging
                                     (the widget re-tints per step; the yaml write is debounced in
                                     App); percent readout beside the thumb. -->
                                <ui:SettingsCard x:Name="FloatingOpacityCard" Header="透明度"
                                                 Description="调节悬浮窗背景的不透明度（文字不受影响，最低 20%）。">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="FloatingOpacityText" Text="100%"
                                                   VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Slider x:Name="FloatingOpacitySlider" Width="180" Margin="12,0,0,0"
                                                Minimum="20" Maximum="100"
                                                SmallChange="1" LargeChange="5"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                ValueChanged="FloatingOpacitySlider_ValueChanged" />
                                    </StackPanel>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                    </StackPanel>
                </local:TouchDragScrollViewer>

                <local:TouchDragScrollViewer x:Name="SamplingPage"
                                             Visibility="Collapsed"
                                             VerticalScrollBarVisibility="Auto"
                                             Style="{DynamicResource {x:Type ScrollViewer}}"
                                             IsEnableSmoothManipulating="False" PanningMode="None"
                                             local:ScrollCacheDuringTouch.Enabled="False">
                    <local:TouchDragScrollViewer.Physics>
                        <local:SnappyScrollPhysics />
                    </local:TouchDragScrollViewer.Physics>
                    <StackPanel Margin="44,0,44,32">

                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="采样项目" />

                        <!-- One card per metric; the toggle enables/disables that metric's
                             sampling entirely (off = the metric is hidden from the taskbar
                             overlay, the later metrics shift forward to fill its slot).
                             Tag = the overlay hit slot (0-4), read by the shared
                             MetricSwitch_Toggled handler. Metrics with sub-settings
                             (磁盘/GPU/网络) are SettingsExpander; CPU/内存 have none, so a
                             plain card. -->

                        <!-- Section-wide option for the five detail views' process lists — first
                             in the section (not a per-metric switch, so a plain card). -->
                        <ui:SettingsCard Header="合并相同程序"
                                         Description="在进程列表中合并相同程序所创建的进程。"
                                         Margin="0,0,0,4">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Merge_20_Regular}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="MergeSwitch" Toggled="MergeSwitch_Toggled" />
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="CPU" Margin="0,0,0,4">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.DeveloperBoard_20_Regular}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="CpuSwitch" Tag="0" Toggled="MetricSwitch_Toggled" />
                        </ui:SettingsCard>

                        <ui:SettingsCard Header="内存" Margin="0,0,0,4">
                            <ui:SettingsCard.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Memory_16_Regular}" />
                            </ui:SettingsCard.HeaderIcon>
                            <ui:ToggleSwitch x:Name="RamSwitch" Tag="1" Toggled="MetricSwitch_Toggled" />
                        </ui:SettingsCard>

                        <ui:SettingsExpander Header="磁盘" IsExpanded="True" Margin="0,0,0,4">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.HardDrive_20_Regular}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:ToggleSwitch x:Name="DiskSwitch" Tag="2" Toggled="MetricSwitch_Toggled" />
                            <ui:SettingsExpander.Items>
                                <!-- 显示方式: what the headline (overlay slot + detail chart) shows.
                                     特定磁盘 enables the disk picker below it (same pattern as
                                     任务栏位置开关 → 任务栏位置). -->
                                <ui:SettingsCard Header="显示方式">
                                    <ComboBox x:Name="DiskDisplayCombo" MinWidth="140" SelectionChanged="DiskDisplayCombo_SelectionChanged">
                                        <ComboBoxItem Content="所有磁盘平均（默认）" />
                                        <ComboBoxItem Content="最高利用率" />
                                        <ComboBoxItem Content="特定磁盘" />
                                    </ComboBox>
                                </ui:SettingsCard>
                                <ui:SettingsCard x:Name="DiskPickCard" Header="特定磁盘">
                                    <ComboBox x:Name="DiskPickCombo" MinWidth="220" SelectionChanged="DiskPickCombo_SelectionChanged" />
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <ui:SettingsExpander Header="GPU" IsExpanded="True" Margin="0,0,0,4">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Video_20_Regular}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:ToggleSwitch x:Name="GpuSwitch" Tag="3" Toggled="MetricSwitch_Toggled" />
                            <ui:SettingsExpander.Items>
                                <!-- Same 显示方式 pair as 磁盘's, but the GPU default is 最高利用率
                                     (Task Manager's sidebar rule). -->
                                <ui:SettingsCard Header="显示方式">
                                    <ComboBox x:Name="GpuDisplayCombo" MinWidth="140" SelectionChanged="GpuDisplayCombo_SelectionChanged">
                                        <ComboBoxItem Content="所有 GPU 平均" />
                                        <ComboBoxItem Content="最高利用率（默认）" />
                                        <ComboBoxItem Content="特定 GPU" />
                                    </ComboBox>
                                </ui:SettingsCard>
                                <ui:SettingsCard x:Name="GpuPickCard" Header="特定 GPU">
                                    <ComboBox x:Name="GpuPickCombo" MinWidth="220" SelectionChanged="GpuPickCombo_SelectionChanged" />
                                </ui:SettingsCard>
                                <!-- 任务栏显示: what the taskbar GPU slot shows — the utilization
                                     row (the default), the temperature row (replaces it), or BOTH
                                     as two stacked rows ("GPU 42%" over "GPU 65°C"). The two cards
                                     below only matter while a temperature shows, so they are
                                     enabled-gated on this combo (the DiskPickCombo pattern). -->
                                <ui:SettingsCard Header="任务栏显示">
                                    <ComboBox x:Name="GpuContentCombo" MinWidth="150" SelectionChanged="GpuContentCombo_SelectionChanged">
                                        <ComboBoxItem Content="使用率（默认）" />
                                        <ComboBoxItem Content="温度" />
                                        <ComboBoxItem Content="使用率 + 温度" />
                                    </ComboBox>
                                </ui:SettingsCard>
                                <ui:SettingsCard x:Name="GpuTempPickCard" Header="温度来源">
                                    <ComboBox x:Name="GpuTempPickCombo" MinWidth="220" SelectionChanged="GpuTempPickCombo_SelectionChanged" />
                                </ui:SettingsCard>
                                <ui:SettingsCard x:Name="GpuTempUnitCard" Header="温度单位"
                                                 Description="同时作用于任务栏与 GPU 详情弹窗。">
                                    <ComboBox x:Name="GpuTempUnitCombo" MinWidth="140" SelectionChanged="GpuTempUnitCombo_SelectionChanged">
                                        <ComboBoxItem Content="摄氏度（默认）" />
                                        <ComboBoxItem Content="华氏度" />
                                    </ComboBox>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                        <ui:SettingsExpander Header="网络" IsExpanded="True" Margin="0,0,0,4">
                            <ui:SettingsExpander.HeaderIcon>
                                <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Globe_20_Regular}" />
                            </ui:SettingsExpander.HeaderIcon>
                            <ui:ToggleSwitch x:Name="NetSwitch" Tag="4" Toggled="MetricSwitch_Toggled" />
                            <ui:SettingsExpander.Items>
                                <!-- 适配器 pick: 自动 (the sampler's max-traffic rule) or one specific
                                     adapter (incl. virtual ones — an explicit pick is how the user
                                     watches a VPN; a missing pick falls back to 自动). Items are
                                     built in code from the adapter enumeration. -->
                                <ui:SettingsCard Header="适配器">
                                    <ComboBox x:Name="NetAdapterCombo" MinWidth="260" SelectionChanged="NetAdapterCombo_SelectionChanged" />
                                </ui:SettingsCard>
                                <!-- 公网 IP lookup: the Network detail panel's 公网 IPv4/IPv6 cells
                                     AND the 公网延迟 ICMP probe (www.baidu.com). Off = NetInfoSampler
                                     sends nothing to the public internet (the cells show "—" / the
                                     v6 row collapses); the LAN-only 本地延迟 ping is unaffected.
                                     Reports immediately. -->
                                <ui:SettingsCard Header="公网 IP"
                                                 Description="查询公网 IPv4 / IPv6 地址并探测公网延迟。">
                                    <ui:ToggleSwitch x:Name="PublicIpSwitch" OnContent="启用" OffContent="关闭"
                                                     Toggled="PublicIpSwitch_Toggled" />
                                </ui:SettingsCard>
                                <!-- Clash/Mihomo integration: the core's proxied per-process traffic
                                     joins the Network detail list as standalone "Clash"-tagged rows
                                     (ClashSampler). Switch reports immediately, text edits debounced
                                     (500ms); 测试连接 probes the CURRENT box contents via GET /version. -->
                                <ui:SettingsCard Header="Clash / Mihomo"
                                                 Description="从代理内核同步实时网速至进程列表。">
                                    <StackPanel>
                                        <ui:ToggleSwitch x:Name="ClashSwitch" OnContent="启用" OffContent="关闭"
                                                         Toggled="ClashSwitch_Toggled" />
                                        <!-- Fixed Width, NOT MinWidth: the card template's content column
                                             is Auto, so a single-line TextBox measures to its full text
                                             width — long input would grow the column and squeeze the
                                             header/description (`*` column) into a one-char-per-line
                                             strip. Same for the result TextBlock (horizontal StackPanel
                                             measures with infinite width, so TextWrapping alone is a
                                             no-op without MaxWidth). -->
                                        <TextBox x:Name="ClashAddressBox" Width="320" Margin="0,8,0,0"
                                                 ui:ControlHelper.PlaceholderText="控制器地址（留空默认 127.0.0.1:9090）"
                                                 TextChanged="ClashApiBox_TextChanged" />
                                        <TextBox x:Name="ClashSecretBox" Width="320" Margin="0,6,0,0"
                                                 ui:ControlHelper.PlaceholderText="API 密钥（可选）"
                                                 TextChanged="ClashApiBox_TextChanged" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="ClashTestButton" Content="测试连接"
                                                    Click="ClashTestButton_Click" />
                                            <TextBlock x:Name="ClashTestResult" VerticalAlignment="Center"
                                                       Margin="10,0,0,0" FontSize="12" MaxWidth="240"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </ui:SettingsCard>
                            </ui:SettingsExpander.Items>
                        </ui:SettingsExpander>

                    </StackPanel>
                </local:TouchDragScrollViewer>

                <!-- 关于 page root is a GRID, not the scroller: the two decorations below are
                     page-FIXED, OUTSIDE the scroll viewport (a decoration inside the
                     ScrollViewer gets hard-clipped at the viewport edge on scroll, and a
                     clip through a gradient's mid-fade is a torn seam). Both blobs bleed
                     off the page — safe now: every edge they meet is a REAL one, since
                     the card sits below the caption strip (visible border + rounded
                     corner + Mica above), so a fade ending there reads naturally. -->
                <Grid x:Name="AboutPage" Visibility="Collapsed">

                    <!-- Top-left glow (the original look, restored): half-hung off the
                         page's top-left corner. -->
                    <Ellipse Width="460" Height="460" IsHitTestVisible="False"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-190,-230,0,0">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#332AA1F2" Offset="0" />
                                <GradientStop Color="#002AA1F2" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Bottom-right corner glow: ends at the card's own corner. -->
                    <Ellipse Width="520" Height="520" IsHitTestVisible="False"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-200,-250">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#2E1282E2" Offset="0" />
                                <GradientStop Color="#001282E2" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- 关于 page content — deliberately NOT the card list the other pages
                         use: a centred hero (logo → name → version pill), the app's own
                         live CPU waveform as the creative touch, two plain link buttons
                         and the copyright line. MinHeight=ViewportHeight centres the
                         column vertically whenever the window has room; the scroller
                         still engages when it doesn't. -->
                    <local:TouchDragScrollViewer x:Name="AboutScroll"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Style="{DynamicResource {x:Type ScrollViewer}}"
                                                 IsEnableSmoothManipulating="False" PanningMode="None"
                                                 local:ScrollCacheDuringTouch.Enabled="False">
                        <local:TouchDragScrollViewer.Physics>
                            <local:SnappyScrollPhysics />
                        </local:TouchDragScrollViewer.Physics>
                        <Grid MinHeight="{Binding ViewportHeight, ElementName=AboutScroll}" Margin="44,0">

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">

                            <!-- logo.svg (viewBox 0 0 256 256) inlined as XAML shapes — base
                                 gradient → clipped sheen/popup/chart/taskbar pill → inner edge;
                                 SVG stop/fill/stroke-opacity folds into ARGB hex. -->
                            <Viewbox Width="88" Height="88" Stretch="Uniform">
                                <Canvas Width="256" Height="256">
                                    <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="56" RadiusY="56">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#63C1F9" Offset="0" />
                                                <GradientStop Color="#2AA1F2" Offset="0.52" />
                                                <GradientStop Color="#1282E2" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Canvas Width="256" Height="256">
                                        <Canvas.Clip>
                                            <RectangleGeometry Rect="8,8,240,240" RadiusX="56" RadiusY="56" />
                                        </Canvas.Clip>
                                        <!-- acrylic sheen on the top half -->
                                        <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="150">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#3DFFFFFF" Offset="0" />
                                                    <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <!-- acrylic detail window + its caption -->
                                        <Rectangle Canvas.Left="60" Canvas.Top="44" Width="136" Height="150" RadiusX="14" RadiusY="14"
                                                   Fill="#14FFFFFF" Stroke="#40FFFFFF" StrokeThickness="1.5" />
                                        <Rectangle Canvas.Left="74" Canvas.Top="56" Width="26" Height="5" RadiusX="2.5" RadiusY="2.5"
                                                   Fill="#66FFFFFF" />
                                        <!-- usage-history chart inside the popup -->
                                        <Path Data="M72 110 C85.6 90 97.5 112 112.7 98 C126.3 85 134.8 68 151.8 80 C165.3 90 172.1 106 184 88 L184 178 L72 178 Z">
                                            <Path.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#33FFFFFF" Offset="0" />
                                                    <GradientStop Color="#05FFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>
                                        <Path Data="M72 110 C85.6 90 97.5 112 112.7 98 C126.3 85 134.8 68 151.8 80 C165.3 90 172.1 106 184 88"
                                              Stroke="#E6FFFFFF" StrokeThickness="6.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <!-- live sample dot -->
                                        <Ellipse Canvas.Left="175" Canvas.Top="79" Width="18" Height="18" Fill="#4D35E08C" />
                                        <Ellipse Canvas.Left="179" Canvas.Top="83" Width="10" Height="10" Fill="#35E08C" />
                                        <!-- taskbar strip: soft shadow + frosted pill -->
                                        <Rectangle Canvas.Left="38" Canvas.Top="150" Width="180" Height="56" RadiusX="28" RadiusY="28"
                                                   Fill="#380B3E6B" />
                                        <Rectangle Canvas.Left="38" Canvas.Top="146" Width="180" Height="56" RadiusX="28" RadiusY="28"
                                                   Stroke="#47FFFFFF" StrokeThickness="1">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#9EFFFFFF" Offset="0" />
                                                    <GradientStop Color="#7AFFFFFF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <!-- group 1: CPU / 内存 -->
                                        <Rectangle Canvas.Left="56" Canvas.Top="163" Width="11" Height="8" RadiusX="4" RadiusY="4" Fill="#731282E2" />
                                        <Rectangle Canvas.Left="71" Canvas.Top="163" Width="24" Height="8" RadiusX="4" RadiusY="4" Fill="#1282E2" />
                                        <Rectangle Canvas.Left="56" Canvas.Top="177" Width="11" Height="8" RadiusX="4" RadiusY="4" Fill="#731282E2" />
                                        <Rectangle Canvas.Left="71" Canvas.Top="177" Width="16" Height="8" RadiusX="4" RadiusY="4" Fill="#5EADF4" />
                                        <!-- group 2: 磁盘 / GPU -->
                                        <Rectangle Canvas.Left="114" Canvas.Top="163" Width="11" Height="8" RadiusX="4" RadiusY="4" Fill="#731282E2" />
                                        <Rectangle Canvas.Left="129" Canvas.Top="163" Width="20" Height="8" RadiusX="4" RadiusY="4" Fill="#1282E2" />
                                        <Rectangle Canvas.Left="114" Canvas.Top="177" Width="11" Height="8" RadiusX="4" RadiusY="4" Fill="#731282E2" />
                                        <Rectangle Canvas.Left="129" Canvas.Top="177" Width="26" Height="8" RadiusX="4" RadiusY="4" Fill="#9B8CF2" />
                                        <!-- group 3: 网络 ↑ / ↓ -->
                                        <Path Data="M192 173 V161 M186.5 166.5 L192 161 L197.5 166.5"
                                              Stroke="#23B57F" StrokeThickness="6" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Path Data="M192 175 V187 M186.5 181.5 L192 187 L197.5 181.5"
                                              Stroke="#F0A02E" StrokeThickness="6" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Canvas>
                                    <!-- Fluent inner edge -->
                                    <Rectangle Canvas.Left="9" Canvas.Top="9" Width="238" Height="238" RadiusX="55" RadiusY="55"
                                               Stroke="#47FFFFFF" StrokeThickness="1.5" />
                                </Canvas>
                            </Viewbox>

                            <TextBlock Text="TaskMonitor" FontSize="30" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,18,0,0" />

                            <!-- The version as a quiet pill instead of a header side-note. -->
                            <Border HorizontalAlignment="Center" Margin="0,10,0,0"
                                    CornerRadius="12" Padding="12,3"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <TextBlock x:Name="VersionText" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <!-- The creative touch: the app's OWN live CPU waveform — push-fed
                                 by RefreshAbout() off App's SnapshotChanged pump (no timer here),
                                 so it only redraws while this page shows, and collapses entirely
                                 while CPU sampling is off (a flat line would be a lie). The dot
                                 rides the newest sample; its pulse is render-thread only. -->
                            <StackPanel x:Name="LiveBand" Width="400" Margin="0,30,0,0" Visibility="Collapsed">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="实时 CPU" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="LiveCpuText" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <Canvas x:Name="LiveWave" Width="400" Height="56" ClipToBounds="True">
                                    <Path x:Name="LiveFill">
                                        <Path.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#3D2AA1F2" Offset="0" />
                                                <GradientStop Color="#002AA1F2" Offset="1" />
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                    </Path>
                                    <Polyline x:Name="LiveLine" StrokeThickness="2" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                        <Polyline.Stroke>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#63C1F9" Offset="0" />
                                                <GradientStop Color="#1282E2" Offset="1" />
                                            </LinearGradientBrush>
                                        </Polyline.Stroke>
                                    </Polyline>
                                    <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#35E08C">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.35" Duration="0:0:1.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Canvas>
                            </StackPanel>

                            <!-- External links: plain Fluent buttons, not cards. The GitHub
                                 icon is the official GitHub mark path (its fill-rule=evenodd
                                 is WPF's default), tinted by the theme. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,34,0,0">
                                <Button Click="GitHubCard_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Fill="{DynamicResource TextFillColorPrimaryBrush}"
                                              Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
                                        <TextBlock Text="GitHub" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="12,0,0,0" Click="AcknowledgementsCard_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:FontIcon Icon="{x:Static ui:FluentSystemIcons.Heart_20_Regular}" FontSize="16" />
                                        <TextBlock Text="参考 / 致谢 / 开源许可" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="Copyright © 2026 双霖（LineSoft）" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,28,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                            <!-- 衍生版标注（2026-11-11 加）。依据是 Apache-2.0 的两条：
                                 §4(b) 修改过的版本必须带「显著提示」说明文件被改过 —— 这一块就是它；
                                 §4(c) 上面那行原作者版权声明必须原样保留 —— 任何时候都不动它；
                                 §4(d) 上游若另有 NOTICE 文件要一并分发（已确认上游仓库只有 LICENSE）。
                                 措辞刻意只做客观来源说明：写清「非官方」「谁改的」「上游在哪」，
                                 不写「官方 / 授权 / 合作」——§6 明确规定许可证不授予使用原作者
                                 姓名或商标做背书（endorsement）的权利，只允许如实描述来源。
                                 原作者若要求调整（例如不希望出现他的名字），删掉本块即可；
                                 版权行与随包的 LICENSE 属于义务，不能一并删。 -->
                            <TextBlock FontSize="12" HorizontalAlignment="Center" Margin="0,36,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="21"
                                       LineStackingStrategy="BlockLineHeight"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                <Run Text="个人修改版 · 非官方发布" />
                                <LineBreak />
                                <Run Text="修改：yimeng007　上游：github.com/linesoft2/TaskMonitor" />
                            </TextBlock>
                        </StackPanel>
                        </Grid>
                    </local:TouchDragScrollViewer>
                </Grid>
            </Grid>
        </ui:NavigationView>

        <!-- Caption band (extended title-bar area), OVERLAID on the NavigationView:
             transparent so the Mica shows through and iNKORE's TitleBar hit-tests it
             as the drag region; the TextBlock itself is hit-test-invisible. The left
             48 DIP stays clear of the hamburger, which lives in this strip now that
             IsTitleBarAutoPaddingEnabled is off — the margin keeps the band from
             swallowing its clicks. The band is 46 tall (pane margin 3 + the 40-tall
             toggle row + 3) so the caption title shares the hamburger's centerline
             (a 32 band would float it ~7 DIP high). Holds only the small caption
             title, Win11-Settings style. -->
        <Border Height="46" VerticalAlignment="Top" Background="Transparent"
                Margin="48,0,0,0">
            <TextBlock Text="设置"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       IsHitTestVisible="False" />
        </Border>
    </Grid>
</Window>
